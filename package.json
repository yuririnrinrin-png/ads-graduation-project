{
  "name": "ti-amo-jewelry-studio",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @ti-amo/web",
    "build": "npm run build -w @ti-amo/shared && npm run build -w @ti-amo/web",
    "db:generate": "npm run db:generate -w @ti-amo/web",
    "db:push": "npm run db:push -w @ti-amo/web",
    "db:seed": "npm run db:seed -w @ti-amo/web"
  },
  "engines": {
    "node": ">=20"
  }
}
