# Copy to apps/web/.env.local (and optionally repo root) before running.
DATABASE_URL="postgresql://tiamo:tiamo@localhost:5432/tiamo"
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="dev-change-me-to-a-long-random-string"
AUTH_USER="ec-team"
AUTH_PASSWORD="studio"
REDIS_URL="redis://localhost:6379"
# Shared job files (web + worker). Default if unset: apps/web/.data
# DATA_ROOT="C:/Users/you/src/ads-graduation-project/apps/web/.data"
# S3-compatible (MinIO). Phase 1–2 may use local disk under .data/
S3_ENDPOINT="http://localhost:9000"
S3_ACCESS_KEY="minio"
S3_SECRET_KEY="miniopass"
S3_BUCKET="tiamo"
# Image gen keys stay on the worker only (never expose to the browser).
# When set, worker uses fal.ai Flux + PuLID for person scenes (~8 calls/job).
# When unset, local silhouette placeholders are used (no spend).
# FAL_KEY=
